# ---------------------------------------------------------------------
# Unity .gitignore — MR Fire Safety Training Simulator
# Rename this file to exactly ".gitignore" and place it in the project ROOT
# (the folder that contains Assets/, Packages/, ProjectSettings/)
# ---------------------------------------------------------------------

# Unity generated folders — never commit these, they are rebuilt locally
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store downloads
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider / VS Code generated files
.vs/
.idea/
.vscode/
.gradle/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for ignored folders
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Packed addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Ss]erver[Dd]ata/

# Autogenerated native plugin import settings
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------
# IMPORTANT — do NOT add these to the ignore list, they MUST be committed:
#   Assets/**/*.meta          (Unity breaks without meta files)
#   ProjectSettings/          (all project configuration)
#   Packages/manifest.json
#   Packages/packages-lock.json   (pins exact package versions)
#   ProjectSettings/ProjectVersion.txt (pins the editor version)
# ---------------------------------------------------------------------
# Meta XR OpenXR API layers — machine-local Editor tooling, regenerated by the SDK
/[Aa]ssets/XR/APILayers~/
